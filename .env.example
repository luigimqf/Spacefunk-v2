# ─────────────────────────────────────────────────────────────────────────────
# SpaceFunk – Discord Music Bot
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Discord ──────────────────────────────────────────────────────────────────
# Bot token — Discord Developer Portal > Your App > Bot > Token
DISCORD_TOKEN=

# Application (client) ID — Discord Developer Portal > Your App > General Information
DISCORD_CLIENT_ID=

# (Optional) Guild ID for development — commands register instantly instead of ~1h globally
# Remove or leave empty to register commands globally (production)
DISCORD_GUILD_ID=

# ── Spotify ───────────────────────────────────────────────────────────────────
# Create an app at https://developer.spotify.com/dashboard
# Note: Spotify tracks are resolved via YouTube search (no direct streaming)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
